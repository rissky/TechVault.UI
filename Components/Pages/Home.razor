@page "/"

<PageTitle>TechVault - Dashboard</PageTitle>

<div style="max-width: 800px; margin: 4rem auto; font-family: sans-serif; text-align: center;">

    <!-- Header Section -->
    <div style="margin-bottom: 3rem;">
        <h1 style="font-size: 3rem; color: #343a40; margin-bottom: 0.5rem;">TechVault</h1>
        <p style="font-size: 1.2rem; color: #6c757d;">Equipment Management & User Administration Portal</p>
    </div>

    <!-- Action Cards -->
    <div style="display: flex; gap: 2rem; justify-content: center;">

        <!-- User Profile Card -->
        <div style="flex: 1; padding: 2rem; background: white; border: 2px solid #e9ecef; border-radius: 12px; transition: transform 0.2s; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
            <h2 style="color: #495057; margin-bottom: 1rem;">User Profiles</h2>
            <p style="color: #6c757d; margin-bottom: 2rem;">Explore profile creation, email validation patterns, and structured data binding.</p>
            <a href="/demo" style="display: inline-block; padding: 12px 24px; background-color: #6c757d; color: white; text-decoration: none; border-radius: 6px; font-weight: bold;">
                Manage Users
            </a>
        </div>

        <!-- Equipment Loan Card -->
        <div style="flex: 1; padding: 2rem; background: white; border: 2px solid #007bff; border-radius: 12px; transition: transform 0.2s; box-shadow: 0 4px 12px rgba(0,123,255,0.15);">
            <h2 style="color: #007bff; margin-bottom: 1rem;">Equipment Loans</h2>
            <p style="color: #6c757d; margin-bottom: 2rem;">Access the practical workspace to implement UI constraints, drop-downs, and error handling.</p>
            <a href="/exerciseaddloan" style="display: inline-block; padding: 12px 24px; background-color: #007bff; color: white; text-decoration: none; border-radius: 6px; font-weight: bold;">
                Open Loan System
            </a>
        </div>

    </div>
</div>